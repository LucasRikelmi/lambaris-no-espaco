# --- Ollama (serviço "ollama" no Docker Compose, porta 11434) ---
# API compatível com a OpenAI em /v1. Dentro do Docker use o nome do serviço.
LM_URL=http://ollama:11434/v1

# Estes modelos são baixados automaticamente na primeira subida do serviço "ollama".
GEMMA_MODEL=gemma3:4b          # Google Gemma 3 4B (conversa em português)
MEDGEMMA_MODEL=medgemma:4b     # MedGemma 4B (foco médico, variante do Gemma 3)
EMBED_MODEL=nomic-embed-text   # embeddings da busca vetorial

# Fora do Docker, rode "ollama serve" na máquina e use http://127.0.0.1:11434/v1.

# --- Voice Studio (narração) ---
# O Compose sobe um TTS compatível com a API OpenAI no serviço "voz" (porta 8880).
# Fora do Docker, troque "voz" por "127.0.0.1".
TTS_URL=http://voz:8880/v1/audio/speech
# Opcional: só se o seu provedor exigir autenticação.
TTS_TOKEN=
TTS_MODEL=kokoro
# Vozes em português do Kokoro: pf_dora (feminina) ou pm_alex (masculina).
TTS_VOICE=pf_dora
